<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/notesListFragment">

    <!-- Notes List Screen -->
    <fragment
        android:id="@+id/notesListFragment"
        android:name="com.example.a1.NotesListFragment"
        android:label=""
        tools:layout="@layout/fragment_notes_list">

        <action
            android:id="@+id/action_notesListFragment_to_noteEditorFragment"
            app:destination="@id/noteEditorFragment"
            app:enterAnim="@android:anim/slide_in_left"
            app:exitAnim="@android:anim/slide_out_right"
            app:popEnterAnim="@android:anim/slide_in_left"
            app:popExitAnim="@android:anim/slide_out_right" />

    </fragment>

    <!-- Note Editor Screen -->
    <fragment
        android:id="@+id/noteEditorFragment"
        android:name="com.example.a1.NoteEditorFragment"
        android:label=""
        tools:layout="@layout/fragment_note_editor">

        <argument
            android:name="noteId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />

    </fragment>

</navigation>